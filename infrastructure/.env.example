# Social-Flow ZeroBaran — Environment configuration
# Copy to .env and fill in. NEVER commit .env to git.

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE=eyJhbGc...your_service_role_key...

# ---------- Telegram Bot ----------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
TELEGRAM_CHAT_ID=-1001234567890       # your personal chat id (use @userinfobot to get it)

# ---------- AI Brain (optional but recommended) ----------
GEMINI_API_KEY=AIza...your_gemini_key
# OR Groq:
# GROQ_API_KEY=gsk_...

# ---------- Platform credentials ----------
# X / Twitter API v2 (OAuth 2.0 Bearer for posting)
X_BEARER_TOKEN=AAAAAAAAAAAA...

# LinkedIn (Marketing API or Personal Profile posting scope)
LINKEDIN_ACCESS_TOKEN=AQX...your_linkedin_token

# Facebook (Page access token)
FACEBOOK_PAGE_TOKEN=EAAB...your_page_token

# ---------- Runner behaviour ----------
MAX_RETRIES=3
LOG_LEVEL=INFO
